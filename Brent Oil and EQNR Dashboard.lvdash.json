{
  "datasets": [
    {
      "name": "57d8e900",
      "displayName": "cards_5m",
      "queryLines": [
        "SELECT\r\n",
        "    CAST(trading_date_oslo AS DATE) AS trading_date_oslo,\r\n",
        "\r\n",
        "    MAX_BY(eqnr_price, timestamp_utc) AS eqnr_price,\r\n",
        "    MAX_BY(brent_price, timestamp_utc) AS brent_price,\r\n",
        "\r\n",
        "    MAX_BY(eqnr_price, timestamp_utc)\r\n",
        "        / MIN_BY(eqnr_price, timestamp_utc) - 1\r\n",
        "        AS eqnr_daily_return,\r\n",
        "\r\n",
        "    MAX_BY(brent_price, timestamp_utc)\r\n",
        "        / MIN_BY(brent_price, timestamp_utc) - 1\r\n",
        "        AS brent_daily_return,\r\n",
        "\r\n",
        "    CORR(\r\n",
        "        eqnr_return_5m_pct,\r\n",
        "        brent_return_5m_pct\r\n",
        "    ) AS correlation\r\n",
        "\r\n",
        "FROM oil_stock.gold.market_5m\r\n",
        "\r\n",
        "GROUP BY trading_date_oslo\r\n",
        "ORDER BY trading_date_oslo"
      ],
      "catalog": "oil_stock",
      "schema": "gold"
    },
    {
      "name": "eee02cc1",
      "displayName": "time_series_5m",
      "queryLines": [
        "SELECT\r\n",
        "    timestamp_oslo,\r\n",
        "    CAST(trading_date_oslo AS DATE) AS trading_date_oslo,\r\n",
        "    date_format(timestamp_oslo, 'HH:mm') AS time_oslo,\r\n",
        "    eqnr_return_5m_pct,\r\n",
        "    brent_return_5m_pct\r\n",
        "FROM oil_stock.gold.market_5m\r\n",
        "ORDER BY timestamp_oslo"
      ]
    },
    {
      "name": "fed9d467",
      "displayName": "rolling_corr_5m",
      "queryLines": [
        "WITH corr AS (\r\n",
        "    SELECT\r\n",
        "        timestamp_oslo,\r\n",
        "        trading_date_oslo,\r\n",
        "        date_format(timestamp_oslo, 'HH:mm') AS time_oslo,\r\n",
        "\r\n",
        "        COUNT(*) OVER (\r\n",
        "            PARTITION BY trading_date_oslo\r\n",
        "            ORDER BY timestamp_utc\r\n",
        "            ROWS BETWEEN 11 PRECEDING AND CURRENT ROW\r\n",
        "        ) AS n_obs,\r\n",
        "\r\n",
        "        CORR(\r\n",
        "            eqnr_return_5m_pct,\r\n",
        "            brent_return_5m_pct\r\n",
        "        ) OVER (\r\n",
        "            PARTITION BY trading_date_oslo\r\n",
        "            ORDER BY timestamp_utc\r\n",
        "            ROWS BETWEEN 11 PRECEDING AND CURRENT ROW\r\n",
        "        ) AS rolling_correlation\r\n",
        "\r\n",
        "    FROM oil_stock.gold.market_5m\r\n",
        ")\r\n",
        "\r\n",
        "SELECT\r\n",
        "    timestamp_oslo,\r\n",
        "    trading_date_oslo,\r\n",
        "    time_oslo,\r\n",
        "\r\n",
        "    CASE\r\n",
        "        WHEN n_obs >= 6 THEN rolling_correlation\r\n",
        "    END AS rolling_correlation\r\n",
        "\r\n",
        "FROM corr\r\n",
        "ORDER BY timestamp_oslo"
      ]
    },
    {
      "name": "1c692532",
      "displayName": "normalized_price_5m",
      "queryLines": [
        "SELECT\r\n",
        "    timestamp_utc,\r\n",
        "    timestamp_oslo,\r\n",
        "    CAST(trading_date_oslo AS DATE) AS trading_date_oslo,\r\n",
        "    date_format(timestamp_oslo, 'HH:mm') AS time_oslo,\r\n",
        "\r\n",
        "    eqnr_price\r\n",
        "        / FIRST_VALUE(eqnr_price) OVER (\r\n",
        "            PARTITION BY trading_date_oslo\r\n",
        "            ORDER BY timestamp_utc\r\n",
        "        ) * 100 AS eqnr_normalized,\r\n",
        "\r\n",
        "    brent_price\r\n",
        "        / FIRST_VALUE(brent_price) OVER (\r\n",
        "            PARTITION BY trading_date_oslo\r\n",
        "            ORDER BY timestamp_utc\r\n",
        "        ) * 100 AS brent_normalized\r\n",
        "\r\n",
        "FROM oil_stock.gold.market_5m\r\n",
        "\r\n",
        "ORDER BY timestamp_utc"
      ]
    },
    {
      "name": "d91cc865",
      "displayName": "1h_volatility_5m",
      "queryLines": [
        "SELECT\r\n",
        "    CAST(trading_date_oslo AS DATE) AS trading_date_oslo,\r\n",
        "    date_format(timestamp_oslo, 'HH:mm') AS time_oslo,\r\n",
        "    \r\n",
        "    STDDEV_SAMP(eqnr_return_5m_pct) OVER (\r\n",
        "        PARTITION BY trading_date_oslo\r\n",
        "        ORDER BY timestamp_utc\r\n",
        "        ROWS BETWEEN 11 PRECEDING AND CURRENT ROW\r\n",
        "    ) AS eqnr_volatility_1h,\r\n",
        "\r\n",
        "    STDDEV_SAMP(brent_return_5m_pct) OVER (\r\n",
        "        PARTITION BY trading_date_oslo\r\n",
        "        ORDER BY timestamp_utc\r\n",
        "        ROWS BETWEEN 11 PRECEDING AND CURRENT ROW\r\n",
        "    ) AS brent_volatility_1h\r\n",
        "FROM oil_stock.gold.market_5m"
      ]
    },
    {
      "name": "8cc32039",
      "displayName": "cards_daily",
      "queryLines": [
        "SELECT\r\n",
        "    MAX_BY(eqnr_price, trading_date) AS eqnr_price,\r\n",
        "    MAX_BY(brent_price, trading_date) AS brent_price,\r\n",
        "\r\n",
        "    MAX_BY(eqnr_price, trading_date)\r\n",
        "        / MIN_BY(eqnr_price, trading_date) - 1\r\n",
        "        AS eqnr_period_return,\r\n",
        "\r\n",
        "    MAX_BY(brent_price, trading_date)\r\n",
        "        / MIN_BY(brent_price, trading_date) - 1\r\n",
        "        AS brent_period_return,\r\n",
        "\r\n",
        "    CORR(\r\n",
        "        eqnr_daily_return,\r\n",
        "        brent_daily_return\r\n",
        "    ) AS correlation\r\n",
        "\r\n",
        "FROM oil_stock.gold.market_daily\r\n",
        "\r\n",
        "WHERE trading_date BETWEEN :date_range.min AND :date_range.max\r\n"
      ],
      "parameters": [
        {
          "displayName": "date_range",
          "keyword": "date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "2026-08-04T00:00:00.000"
              },
              "max": {
                "value": "2026-08-18T23:59:59.999"
              }
            }
          }
        }
      ]
    },
    {
      "name": "09caab24",
      "displayName": "normalized_price_daily",
      "queryLines": [
        "WITH filtered AS (\r\n",
        "  SELECT\r\n",
        "    *\r\n",
        "  FROM oil_stock.gold.market_daily\r\n",
        "  WHERE trading_date BETWEEN :date_range.min AND :date_range.max\r\n",
        ")\r\n",
        "\r\n",
        "SELECT\r\n",
        "  trading_date,\r\n",
        "\r\n",
        "  eqnr_price / FIRST_VALUE(eqnr_price) OVER(ORDER BY trading_date) * 100 AS eqnr_normalized,\r\n",
        "  brent_price / FIRST_VALUE(brent_price) OVER(ORDER BY trading_date) * 100 AS brent_normalized \r\n",
        "  \r\n",
        "FROM filtered\r\n",
        "ORDER BY trading_date\r\n"
      ],
      "parameters": [
        {
          "displayName": "date_range",
          "keyword": "date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
