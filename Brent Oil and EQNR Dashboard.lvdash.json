                "value": "2026-08-10T00:00:00.000"
              },
              "max": {
                "value": "2026-08-24T23:59:59.999"
              }
            }
          }
        }
      ]
    },
    {
      "name": "f9e4c861",
      "displayName": "rolling_corr_daily",
      "queryLines": [
        "WITH filtered AS (\r\n",
        "    SELECT *\r\n",
        "    FROM oil_stock.gold.market_daily\r\n",
        "    WHERE trading_date BETWEEN :date_range.min AND :date_range.max\r\n",
        "),\r\n",
        "\r\n",
        "corr AS (\r\n",
        "    SELECT\r\n",
        "        trading_date,\r\n",
        "\r\n",
        "        COUNT(*) OVER (\r\n",
        "            ORDER BY trading_date\r\n",
        "            ROWS BETWEEN 29 PRECEDING AND CURRENT ROW\r\n",
        "        ) AS n_obs,\r\n",
        "\r\n",
        "        CORR(\r\n",
        "            eqnr_daily_return,\r\n",
        "            brent_daily_return\r\n",
        "        ) OVER (\r\n",
        "            ORDER BY trading_date\r\n",
        "            ROWS BETWEEN 29 PRECEDING AND CURRENT ROW\r\n",
        "        ) AS rolling_correlation\r\n",
        "\r\n",
        "    FROM filtered\r\n",
        ")\r\n",
        "\r\n",
        "SELECT\r\n",
        "    trading_date,\r\n",
        "    CASE\r\n",
        "        WHEN n_obs >= 12 THEN rolling_correlation\r\n",
        "    END AS rolling_correlation\r\n",
        "\r\n",
        "FROM corr\r\n",
        "ORDER BY trading_date"
      ],
      "parameters": [
